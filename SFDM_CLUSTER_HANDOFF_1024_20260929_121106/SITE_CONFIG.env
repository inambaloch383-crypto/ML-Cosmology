# Cluster administrator: edit only if desired.
# The scripts also work when this archive is kept together under one directory.

# Root of the unpacked handoff package.
# Leave AUTO to resolve to the directory containing this file.
PROJECT_ROOT=AUTO

# Build parallelism. Keep AxioNyx modest initially to avoid memory pressure.
BUILD_JOBS_MUSIC=4
BUILD_JOBS_AXIONYX=2

# Optional module commands are intentionally NOT hard-coded.
# Load site modules before invoking the build script, e.g.:
#   module load gcc openmpi fftw gsl
